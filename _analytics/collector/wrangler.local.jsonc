{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "carlo-site-aggregate-analytics-local",
  "main": "src/index.js",
  "compatibility_date": "2026-08-10",
  "workers_dev": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:4000,http://localhost:4000,http://127.0.0.1:4199",
    "RETENTION_MONTHS": "1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carlo-site-aggregate-analytics-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
