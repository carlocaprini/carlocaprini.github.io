{
  "name": "carlo-site-aggregate-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:integration": "node tests/local-integration.mjs",
    "local:dev": "wrangler dev --local --config wrangler.local.jsonc --ip 0.0.0.0 --port 8787 --persist-to .wrangler/state",
    "local:migrate": "wrangler d1 migrations apply carlo-site-aggregate-analytics-local --local --config wrangler.local.jsonc --persist-to .wrangler/state",
    "local:report": "node ../reports/generate-report.mjs --local",
    "local:reset": "node scripts/reset-local-state.mjs",
    "deploy": "node scripts/assert-production-ready.mjs && wrangler deploy --config wrangler.jsonc"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  }
}
