#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

usage() {
  cat <<'EOF'
Usage: bin/check <command>

Commands:
  source                 Ruby syntax, validator fixtures and source contracts
  generated              Production Jekyll build and generated-site validation
  analytics              Analytics contract and unit tests
  analytics-integration  Browser -> Worker -> D1 integration
  infrastructure         Docker Compose configuration
  browser                Chromium desktop/mobile/tablet suite
  webkit                 Focused WebKit smoke suite
  visual-regression      Playwright visual-regression suite
  visual-reference       Versioned Visual Reference freshness
  visual                 Visual regression and Visual Reference freshness
  all                    Closest practical local equivalent of the merge gate
EOF
}

check_source() {
  ruby -c scripts/lib/validation.rb
  ruby -c scripts/validate_source.rb
  ruby -c scripts/validate_site.rb
  ruby tests/validators/validator_test.rb
  ruby scripts/validate_source.rb
}

check_generated() {
  if bundle exec jekyll --version >/dev/null 2>&1; then
    JEKYLL_ENV=production bundle exec jekyll build --strict_front_matter
  else
    docker compose run --rm -e JEKYLL_ENV=production site bundle exec jekyll build --strict_front_matter
  fi
  ruby scripts/validate_site.rb
}

check_analytics() { npm run test:analytics; }
check_analytics_integration() { npm run test:analytics:integration; }
check_infrastructure() { docker compose config >/dev/null; }
check_browser() { npm run test:browser; }
check_webkit() { npm run test:browser:webkit; }
check_visual_regression() { npm run test:browser:visual; }
check_visual_reference() { npm run visual-reference:check; }

check_visual() {
  check_visual_regression
  check_visual_reference
}

check_all() {
  check_source
  check_generated
  check_analytics
  check_analytics_integration
  check_infrastructure
  check_browser
  check_webkit
  check_visual
}

case "${1:-}" in
  source) check_source ;;
  generated) check_generated ;;
  analytics) check_analytics ;;
  analytics-integration) check_analytics_integration ;;
  infrastructure) check_infrastructure ;;
  browser) check_browser ;;
  webkit) check_webkit ;;
  visual-regression) check_visual_regression ;;
  visual-reference) check_visual_reference ;;
  visual) check_visual ;;
  all) check_all ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
