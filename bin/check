#!/usr/bin/env bash
set -euo pipefail

case "${1:-all}" in
  source)
    node --test tests/legacy/source.test.js
    ruby tests/legacy/feed_test.rb
    ;;
  generated)
    node scripts/build_legacy_site.mjs
    node --test tests/legacy/generated.test.js
    ruby scripts/validate_feed.rb _site/feed.xml
    ;;
  browser)
    npx playwright test
    ;;
  all)
    "$0" source
    "$0" generated
    "$0" browser
    ;;
  *)
    echo "Usage: bin/check [source|generated|browser|all]" >&2
    exit 2
    ;;
esac
